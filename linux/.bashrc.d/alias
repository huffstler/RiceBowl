# Acronym: [G]o [I]nto [V]olume
# Would have been Go To Volume, but that all involves the left hand for typing (on qwerty at least)
# Might not even work as is, user needs read permissions for where podman volumes are stored.
giv () {
    if [[ ! $(podman volume ls --format="{{.Name}}") =~ $volume ]]; then
        echo "Provided volume doesn't exist."
        exit 1
    else
        dir=$(podman volume inspect $1 --format '{{.Mountpoint}}')
        cd "$dir"
    fi
}

